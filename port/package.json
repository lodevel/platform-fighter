{
  "name": "platform-fighter-port",
  "private": true,
  "type": "module",
  "description": "Three.js renderer + HTML menus for the Phaser → Three.js port (docs/review/2026-10-13/threejs-port/PLAN.md). Uses the root package's vite/typescript/vitest.",
  "scripts": {
    "dev": "vite --port 4210 --strictPort",
