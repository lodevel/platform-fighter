    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.1.0",
    "@fontsource/chakra-petch": "^5.1.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0"
  }
}
