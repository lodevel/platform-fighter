{
  "name": "platform-fighter",
  "version": "0.1.0",
  "description": "A platform fighter built with Three.js, HTML menus and a deterministic Matter.js simulation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "preview": "vite preview --base /platform-fighter/",
    "typecheck": "tsc --noEmit && node port/scripts/check-layers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:copy": "tsx scripts/copy-runtime-assets.ts",
    "assets:compress": "python3 tools/encode-compressed-sheets.py",
    "build:static": "npm run build && npm run assets:copy",
    "lab": "vite --config vite.character-lab.config.ts",
    "lab:build": "vite build --config vite.character-lab.config.ts",
    "character:export": "tsx scripts/export-character-packages.ts"
  },
  "keywords": [
    "three",
    "matter-js",
    "platform-fighter",
    "game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "0.170.0",
    "@fontsource/bungee": "^5.1.0",
    "@fontsource/chakra-petch": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.5.0",
    "@types/three": "0.170.0"
  }
}
